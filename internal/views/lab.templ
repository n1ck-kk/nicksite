package views

import "github.com/n1ck-kk/nicksite/internal/lab"

templ LabLogin(errMsg string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Lab — Nick Leuer</title>
		<link rel="stylesheet" href="/static/css/base.css"/>
		<link rel="stylesheet" href="/static/css/lab.css"/>
	</head>
	<body>
		<div class="lab-login-wrap">
			<div class="lab-login-card">
				<p class="lab-login-icon">🔬</p>
				<h1 class="lab-login-title">Idea Lab</h1>
				<p class="lab-login-sub">Private access only.</p>
				<form method="POST" action="/lab" class="lab-login-form">
					<input
						type="password"
						name="password"
						placeholder="Password"
						class="lab-input"
						autofocus
					/>
					if errMsg != "" {
						<p class="lab-error">{ errMsg }</p>
					}
					<button type="submit" class="btn btn-primary lab-submit">Enter</button>
				</form>
			</div>
		</div>
	</body>
	</html>
}

templ LabIdeas(ideas []lab.Idea) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Lab — Nick Leuer</title>
		<link rel="stylesheet" href="/static/css/base.css"/>
		<link rel="stylesheet" href="/static/css/lab.css"/>
	</head>
	<body>
		<nav class="nav">
			<div class="nav-inner">
				<a href="/" class="nav-logo">nick leuer</a>
				<div class="nav-links">
					<span class="lab-badge">🔬 Lab</span>
					<form method="POST" action="/lab/logout" style="margin:0">
						<button type="submit" class="lab-logout">Leave</button>
					</form>
				</div>
			</div>
		</nav>
		<div class="lab-hero">
			<div class="lab-hero-inner">
				<h1 class="lab-hero-title">Idea Lab</h1>
				<p class="lab-hero-sub">Private workspace for concepts, mocks, and builds in progress.</p>
				<div class="lab-stats">
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(len(ideas)) }</span>
						<span class="lab-stat-label">Ideas</span>
					</div>
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(countByStatus(ideas, lab.StatusBuilding)) }</span>
						<span class="lab-stat-label">Building</span>
					</div>
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(countByStatus(ideas, lab.StatusShipped)) }</span>
						<span class="lab-stat-label">Shipped</span>
					</div>
				</div>
			</div>
		</div>
		<section class="lab-showcase">
			<div class="lab-showcase-inner">
				<p class="lab-showcase-label">↳ concept render · military AR glasses</p>
				<svg class="glasses-svg" viewBox="0 0 700 310" xmlns="http://www.w3.org/2000/svg" aria-label="Military AR glasses with drone HUD on bottom-right lens">
					<defs>
						<clipPath id="gl-rclip">
							<rect x="415" y="68" width="234" height="184" rx="16"/>
						</clipPath>
						<clipPath id="gl-lclip">
							<rect x="51" y="68" width="234" height="184" rx="16"/>
						</clipPath>
						<linearGradient id="gl-lens" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#1c2340" stop-opacity="0.32"/>
							<stop offset="100%" stop-color="#0c1428" stop-opacity="0.52"/>
						</linearGradient>
						<linearGradient id="gl-reflect" x1="0" y1="0" x2="1" y2="1">
							<stop offset="0%" stop-color="white" stop-opacity="0.07"/>
							<stop offset="50%" stop-color="white" stop-opacity="0.02"/>
							<stop offset="100%" stop-color="white" stop-opacity="0"/>
						</linearGradient>
						<filter id="gl-glow" x="-30%" y="-30%" width="160%" height="160%">
							<feGaussianBlur stdDeviation="1.8" result="b"/>
							<feMerge>
								<feMergeNode in="b"/>
								<feMergeNode in="SourceGraphic"/>
							</feMerge>
						</filter>
					</defs>
					<!-- temples -->
					<path d="M57 120 L-12 102" stroke="#272740" stroke-width="16" stroke-linecap="round" fill="none"/>
					<path d="M57 120 L-12 102" stroke="#38384f" stroke-width="11" stroke-linecap="round" fill="none"/>
					<path d="M643 120 L712 102" stroke="#272740" stroke-width="16" stroke-linecap="round" fill="none"/>
					<path d="M643 120 L712 102" stroke="#38384f" stroke-width="11" stroke-linecap="round" fill="none"/>
					<!-- left lens fill -->
					<rect x="51" y="68" width="234" height="184" rx="16" fill="url(#gl-lens)"/>
					<!-- right lens fill -->
					<rect x="415" y="68" width="234" height="184" rx="16" fill="url(#gl-lens)"/>
					<!-- drone HUD overlay — bottom of right lens -->
					<g clip-path="url(#gl-rclip)">
						<!-- HUD background -->
						<rect x="415" y="156" width="234" height="96" fill="#020d05"/>
						<!-- aerial grid lines -->
						<line x1="415" y1="165" x2="649" y2="165" stroke="#00e87a" stroke-width="0.4" opacity="0.5"/>
						<line x1="415" y1="172" x2="649" y2="172" stroke="#00e87a" stroke-width="0.4" opacity="0.42"/>
						<line x1="415" y1="181" x2="649" y2="181" stroke="#00e87a" stroke-width="0.4" opacity="0.36"/>
						<line x1="415" y1="192" x2="649" y2="192" stroke="#00e87a" stroke-width="0.4" opacity="0.30"/>
						<line x1="415" y1="205" x2="649" y2="205" stroke="#00e87a" stroke-width="0.4" opacity="0.24"/>
						<line x1="415" y1="220" x2="649" y2="220" stroke="#00e87a" stroke-width="0.4" opacity="0.18"/>
						<line x1="415" y1="237" x2="649" y2="237" stroke="#00e87a" stroke-width="0.4" opacity="0.13"/>
						<line x1="448" y1="156" x2="448" y2="252" stroke="#00e87a" stroke-width="0.4" opacity="0.18"/>
						<line x1="490" y1="156" x2="490" y2="252" stroke="#00e87a" stroke-width="0.4" opacity="0.15"/>
						<line x1="532" y1="156" x2="532" y2="252" stroke="#00e87a" stroke-width="0.4" opacity="0.15"/>
						<line x1="574" y1="156" x2="574" y2="252" stroke="#00e87a" stroke-width="0.4" opacity="0.15"/>
						<line x1="616" y1="156" x2="616" y2="252" stroke="#00e87a" stroke-width="0.4" opacity="0.18"/>
						<!-- terrain features -->
						<ellipse cx="468" cy="208" rx="20" ry="7" fill="#00994d" opacity="0.18"/>
						<ellipse cx="590" cy="194" rx="14" ry="5" fill="#00994d" opacity="0.15"/>
						<ellipse cx="528" cy="222" rx="24" ry="8" fill="#00994d" opacity="0.13"/>
						<path d="M430 156 Q507 192 557 252" stroke="#33ffaa" stroke-width="1.2" fill="none" opacity="0.22"/>
						<!-- corner brackets -->
						<path d="M427 166 L427 160 L435 160" stroke="#00e87a" stroke-width="1.5" fill="none" filter="url(#gl-glow)"/>
						<path d="M637 166 L637 160 L629 160" stroke="#00e87a" stroke-width="1.5" fill="none" filter="url(#gl-glow)"/>
						<path d="M427 246 L427 252 L435 252" stroke="#00e87a" stroke-width="1.5" fill="none" filter="url(#gl-glow)"/>
						<path d="M637 246 L637 252 L629 252" stroke="#00e87a" stroke-width="1.5" fill="none" filter="url(#gl-glow)"/>
						<!-- crosshair -->
						<g filter="url(#gl-glow)">
							<line x1="532" y1="190" x2="532" y2="214" stroke="#00e87a" stroke-width="0.8"/>
							<line x1="520" y1="202" x2="544" y2="202" stroke="#00e87a" stroke-width="0.8"/>
							<circle cx="532" cy="202" r="2" fill="#00e87a" opacity="0.9"/>
							<circle cx="532" cy="202" r="7.5" fill="none" stroke="#00e87a" stroke-width="0.7" opacity="0.5"/>
						</g>
						<!-- top status bar -->
						<rect x="415" y="156" width="234" height="13" fill="#000000" opacity="0.65"/>
						<text x="421" y="165.5" font-family="monospace" font-size="7.5" fill="#00e87a">ALT 312m</text>
						<text x="473" y="165.5" font-family="monospace" font-size="7.5" fill="#00e87a" opacity="0.85">SPD 42kt</text>
						<text x="525" y="165.5" font-family="monospace" font-size="7.5" fill="#00e87a" opacity="0.85">HDG 224°</text>
						<circle cx="619" cy="160" r="3.5" fill="#ff3333" class="gl-live-dot"/>
						<text x="625" y="165" font-family="monospace" font-size="7.5" fill="#ff5555" font-weight="bold">REC</text>
						<!-- bottom status bar -->
						<rect x="415" y="241" width="234" height="11" fill="#000000" opacity="0.65"/>
						<text x="421" y="249" font-family="monospace" font-size="6.5" fill="#00e87a" opacity="0.7">DRONE-7 · CH2 · 5.8GHz · THERMAL:OFF</text>
						<!-- scan line -->
						<rect x="415" y="156" width="234" height="2" fill="#00e87a" opacity="0.4" class="gl-scan"/>
					</g>
					<!-- HUD divider -->
					<line x1="420" y1="156" x2="644" y2="156" stroke="#00e87a" stroke-width="0.7" opacity="0.55"/>
					<!-- lens reflections -->
					<rect x="51" y="68" width="234" height="184" rx="16" fill="url(#gl-reflect)"/>
					<rect x="415" y="68" width="234" height="184" rx="16" fill="url(#gl-reflect)"/>
					<!-- glare highlight -->
					<ellipse cx="118" cy="94" rx="44" ry="16" fill="white" opacity="0.035" transform="rotate(-15 118 94)"/>
					<ellipse cx="482" cy="94" rx="44" ry="16" fill="white" opacity="0.035" transform="rotate(-15 482 94)"/>
					<!-- frame borders (on top) -->
					<rect x="51" y="68" width="234" height="184" rx="16" fill="none" stroke="#464660" stroke-width="9"/>
					<rect x="415" y="68" width="234" height="184" rx="16" fill="none" stroke="#464660" stroke-width="9"/>
					<!-- inner bevel -->
					<rect x="56" y="73" width="224" height="174" rx="12" fill="none" stroke="#5c5c7a" stroke-width="1.5" opacity="0.38"/>
					<rect x="420" y="73" width="224" height="174" rx="12" fill="none" stroke="#5c5c7a" stroke-width="1.5" opacity="0.38"/>
					<!-- bridge -->
					<path d="M285 134 Q350 152 415 134" stroke="#333348" stroke-width="11" stroke-linecap="round" fill="none"/>
					<path d="M285 134 Q350 152 415 134" stroke="#464660" stroke-width="7" stroke-linecap="round" fill="none"/>
					<!-- nose pads -->
					<rect x="280" y="140" width="7" height="20" rx="3" fill="#404058"/>
					<rect x="413" y="140" width="7" height="20" rx="3" fill="#404058"/>
				</svg>
				<p class="lab-showcase-caption">tactical AR glasses · drone live-feed HUD overlay on bottom-right lens</p>
			</div>
		</section>
		<main class="lab-main">
			<div class="lab-grid">
				for _, idea := range ideas {
					@labIdeaCard(idea)
				}
			</div>
		</main>
	</body>
	</html>
}

templ labIdeaCard(idea lab.Idea) {
	<div class="lab-card">
		<div class="lab-card-top">
			<span class={ "lab-status", "lab-status--" + statusSlug(string(idea.Status)) }>{ string(idea.Status) }</span>
		</div>
		<h3 class="lab-card-name">{ idea.Name }</h3>
		<p class="lab-card-desc">{ idea.Description }</p>
		if len(idea.Links) > 0 {
			<div class="lab-card-links">
				for _, link := range idea.Links {
					<a href={ templ.SafeURL(link.URL) } target="_blank" rel="noopener" class="lab-card-link">{ link.Label } ↗</a>
				}
			</div>
		}
	</div>
}

func statusSlug(s string) string {
	switch s {
	case "Exploring":
		return "exploring"
	case "Building":
		return "building"
	case "Validating":
		return "validating"
	case "Shipped":
		return "shipped"
	default:
		return "paused"
	}
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	result := ""
	for n > 0 {
		result = string(rune('0'+n%10)) + result
		n /= 10
	}
	return result
}

func countByStatus(ideas []lab.Idea, status lab.Status) int {
	count := 0
	for _, i := range ideas {
		if i.Status == status {
			count++
		}
	}
	return count
}
