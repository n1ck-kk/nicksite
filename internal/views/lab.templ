package views

import "github.com/n1ck-kk/nicksite/internal/lab"

templ LabLogin(errMsg string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Lab — Nick Leuer</title>
		<link rel="stylesheet" href="/static/css/base.css"/>
		<link rel="stylesheet" href="/static/css/lab.css"/>
	</head>
	<body>
		<div class="lab-login-wrap">
			<div class="lab-login-card">
				<p class="lab-login-icon">🔬</p>
				<h1 class="lab-login-title">Idea Lab</h1>
				<p class="lab-login-sub">Private access only.</p>
				<form method="POST" action="/lab" class="lab-login-form">
					<input
						type="password"
						name="password"
						placeholder="Password"
						class="lab-input"
						autofocus
					/>
					if errMsg != "" {
						<p class="lab-error">{ errMsg }</p>
					}
					<button type="submit" class="btn btn-primary lab-submit">Enter</button>
				</form>
			</div>
		</div>
	</body>
	</html>
}

templ LabIdeas(ideas []lab.Idea) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>Lab — Nick Leuer</title>
		<link rel="stylesheet" href="/static/css/base.css"/>
		<link rel="stylesheet" href="/static/css/lab.css"/>
	</head>
	<body>
		<nav class="nav">
			<div class="nav-inner">
				<a href="/" class="nav-logo">nick leuer</a>
				<div class="nav-links">
					<span class="lab-badge">🔬 Lab</span>
					<form method="POST" action="/lab/logout" style="margin:0">
						<button type="submit" class="lab-logout">Leave</button>
					</form>
				</div>
			</div>
		</nav>
		<div class="lab-hero">
			<div class="lab-hero-inner">
				<h1 class="lab-hero-title">Idea Lab</h1>
				<p class="lab-hero-sub">Private workspace for concepts, mocks, and builds in progress.</p>
				<div class="lab-stats">
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(len(ideas)) }</span>
						<span class="lab-stat-label">Ideas</span>
					</div>
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(countByStatus(ideas, lab.StatusBuilding)) }</span>
						<span class="lab-stat-label">Building</span>
					</div>
					<div class="lab-stat">
						<span class="lab-stat-num">{ itoa(countByStatus(ideas, lab.StatusShipped)) }</span>
						<span class="lab-stat-label">Shipped</span>
					</div>
				</div>
			</div>
		</div>
		<main class="lab-main">
			<div class="lab-grid">
				for _, idea := range ideas {
					@labIdeaCard(idea)
				}
			</div>
		</main>
	</body>
	</html>
}

templ labIdeaCard(idea lab.Idea) {
	<div class="lab-card">
		<div class="lab-card-top">
			<span class={ "lab-status", "lab-status--" + statusSlug(string(idea.Status)) }>{ string(idea.Status) }</span>
		</div>
		<h3 class="lab-card-name">{ idea.Name }</h3>
		<p class="lab-card-desc">{ idea.Description }</p>
		if len(idea.Links) > 0 {
			<div class="lab-card-links">
				for _, link := range idea.Links {
					<a href={ templ.SafeURL(link.URL) } target="_blank" rel="noopener" class="lab-card-link">{ link.Label } ↗</a>
				}
			</div>
		}
	</div>
}

func statusSlug(s string) string {
	switch s {
	case "Exploring":
		return "exploring"
	case "Building":
		return "building"
	case "Validating":
		return "validating"
	case "Shipped":
		return "shipped"
	default:
		return "paused"
	}
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	result := ""
	for n > 0 {
		result = string(rune('0'+n%10)) + result
		n /= 10
	}
	return result
}

func countByStatus(ideas []lab.Idea, status lab.Status) int {
	count := 0
	for _, i := range ideas {
		if i.Status == status {
			count++
		}
	}
	return count
}
