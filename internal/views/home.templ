package views

templ Home() {
	<!-- Hero -->
	<section class="hero" id="hero">
		<div class="hero-inner">
			<p class="hero-greeting">Hi, I'm</p>
			<h1 class="hero-name">Nick Leuer</h1>
			<p class="hero-title">Software Engineer</p>
			<p class="hero-desc">
				I build full-stack web apps — clean backends, fast frontends, shipped to production.
			</p>
			<div class="hero-cta">
				<a href="#projects" class="btn btn-primary">See My Work</a>
				<a href="#contact" class="btn btn-outline">Get In Touch</a>
			</div>
		</div>
	</section>

	<!-- About -->
	<section class="section" id="about">
		<div class="section-inner">
			<h2 class="section-title">About</h2>
			<div class="about-grid">
				<div class="about-text">
					<p>
						I'm a software engineer with a focus on backend systems and developer tooling.
						I love working close to the metal — Go, Postgres, Linux — and shipping things that actually work.
					</p>
					<p>
						When I'm not coding I'm probably learning Italian, lifting, or exploring a new rabbit hole.
					</p>
				</div>
				<div class="about-stack">
					<h3>Stack</h3>
					<ul class="stack-list">
						<li>Go</li>
						<li>PostgreSQL</li>
						<li>templ + HTMX</li>
						<li>Docker / Azure</li>
						<li>Python</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Projects -->
	<section class="section section-alt" id="projects">
		<div class="section-inner">
			<h2 class="section-title">Projects</h2>
			<div class="projects-grid">
				@projectCard(
					"italian.ai",
					"AI-powered Italian language learning app. Conversation practice, spaced-repetition vocabulary, grammar extraction — all backed by Groq LLM and ElevenLabs TTS.",
					[]string{"Go", "templ", "HTMX", "PostgreSQL", "Groq"},
					"https://github.com/n1ck-kk/italian.ai",
					"",
				)
				@projectCard(
					"BoilerBets",
					"Sports betting analytics platform with ML-driven predictions and a live dashboard.",
					[]string{"Python", "Go", "PostgreSQL"},
					"https://github.com/n1ck-kk/BoilerBets",
					"",
				)
				@projectCard(
					"dockr",
					"Docker management TUI — browse containers, stream logs, exec shells, all from the terminal.",
					[]string{"Go", "Bubble Tea"},
					"https://github.com/n1ck-kk/dockr",
					"",
				)
			</div>
		</div>
	</section>

	<!-- Contact -->
	<section class="section" id="contact">
		<div class="section-inner section-center">
			<h2 class="section-title">Contact</h2>
			<p class="contact-desc">I'm open to interesting projects and full-time opportunities.</p>
			<div class="contact-links">
				<a href="mailto:nickleuer24@gmail.com" class="contact-link">
					<span>Email</span>
				</a>
				<a href="https://github.com/n1ck-kk" class="contact-link" target="_blank" rel="noopener">
					<span>GitHub</span>
				</a>
				<a href="https://linkedin.com/in/nickleuer" class="contact-link" target="_blank" rel="noopener">
					<span>LinkedIn</span>
				</a>
			</div>
		</div>
	</section>
}

templ projectCard(name, desc string, tags []string, github, demo string) {
	<div class="project-card">
		<h3 class="project-name">{ name }</h3>
		<p class="project-desc">{ desc }</p>
		<div class="project-tags">
			for _, tag := range tags {
				<span class="tag">{ tag }</span>
			}
		</div>
		<div class="project-links">
			if github != "" {
				<a href={ templ.SafeURL(github) } target="_blank" rel="noopener" class="project-link">GitHub</a>
			}
			if demo != "" {
				<a href={ templ.SafeURL(demo) } target="_blank" rel="noopener" class="project-link project-link-demo">Live</a>
			}
		</div>
	</div>
}
